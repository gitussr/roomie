<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Roomie.Core\Roomie.Core.csproj" />
    <ProjectReference Include="..\Roomie.Network\Roomie.Network.csproj" />
    <ProjectReference Include="..\Roomie.Infrastructure\Roomie.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon, which WPF doesn't have. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\roomie.ico</ApplicationIcon>
    <!-- Required by the generated code behind LibraryImport. Roomie's own code has no unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms names such as Button and Application would clash with WPF's in every file. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\roomie.ico" />
    <Resource Include="Assets\roomie.png" />
  </ItemGroup>

</Project>
