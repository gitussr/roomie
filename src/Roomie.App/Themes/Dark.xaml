<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#1C1919" />
    <SolidColorBrush x:Key="RailBrush" Color="#151313" />
    <SolidColorBrush x:Key="PaneBrush" Color="#221E1E" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#2B2626" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#2B2626" />
    <SolidColorBrush x:Key="HoverBrush" Color="#352F2F" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#4A2C2C" />
    <SolidColorBrush x:Key="LineBrush" Color="#3A3434" />
    <SolidColorBrush x:Key="ControlLineBrush" Color="#857A7A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3EEEE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B9AEAE" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#857A7A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#BC4F4F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#CC6262" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MineBubbleBrush" Color="#4A2C2C" />
    <SolidColorBrush x:Key="TheirBubbleBrush" Color="#2B2626" />
    <SolidColorBrush x:Key="ProblemBrush" Color="#FF9A8F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#71D39A" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#403418" />
    <SolidColorBrush x:Key="OnlineBrush" Color="#5CC98A" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#6E6464" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#F21C1919" />
    <!-- Only the high-contrast colours draw these, where a change of fill alone wouldn't show. -->
    <SolidColorBrush x:Key="RowLineBrush" Color="Transparent" />
    <Thickness x:Key="HoverLineThickness">1</Thickness>
</ResourceDictionary>
