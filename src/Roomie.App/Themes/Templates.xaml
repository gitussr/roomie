<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Roomie.App.ViewModels">

    <!-- One file transfer, shown the same way in a conversation and on the Transfers screen. -->
    <DataTemplate DataType="{x:Type vm:FileTransferItem}">
        <Border Margin="0,4,0,0" Padding="10,8" Background="{DynamicResource SubtleBrush}" CornerRadius="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,2,10,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="{Binding DirectionGlyph}"
                           Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.Name="{Binding DirectionLabel}" />
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding PeerLine}" Style="{StaticResource MutedWhenEmpty}" />
                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Warning}" FontSize="12" Style="{StaticResource ProblemText}" />
                    <ProgressBar Margin="0,5,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                 Visibility="{Binding IsMoving, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="{Binding Name, StringFormat='Progress of {0}'}" />
                    <WrapPanel Margin="0,6,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="10,3" />
                            </Style>
                        </WrapPanel.Resources>
                        <Button Content="Accept" Style="{StaticResource PrimaryButton}" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding DataContext.Chat.AcceptFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Accept {0}'}" />
                        <Button Content="Decline"
                                Command="{Binding DataContext.Chat.DeclineFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanAnswer, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Decline {0}'}" />
                        <Button Content="Cancel"
                                Command="{Binding DataContext.Chat.CancelFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Cancel {0}'}" />
                        <Button Content="Show in folder"
                                Command="{Binding DataContext.Chat.ShowFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanShow, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in folder'}" />
                        <Button Content="Send again"
                                Command="{Binding DataContext.Chat.SendFileAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanSendAgain, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Send {0} again'}" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
