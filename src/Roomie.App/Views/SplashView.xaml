<UserControl x:Class="Roomie.App.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBrush}"
             Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="Roomie is opening. Click to skip.">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- The logo appears through a circle that grows from its centre. -->
        <Image x:Name="Logo" Source="/Assets/roomie.png" Width="148" Height="148" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Image.Clip>
                <EllipseGeometry Center="74,74" RadiusX="0" RadiusY="0" />
            </Image.Clip>
            <Image.RenderTransform>
                <ScaleTransform x:Name="LogoScale" ScaleX="0.82" ScaleY="0.82" />
            </Image.RenderTransform>
        </Image>
        <TextBlock x:Name="Wordmark" Text="Roomie" Margin="0,18,0,0" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="WordmarkShift" Y="14" />
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="Tagline" Text="Chat and files, right on your own network" Margin="0,6,0,0" FontSize="14"
                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Opacity="0" />
    </StackPanel>
</UserControl>
