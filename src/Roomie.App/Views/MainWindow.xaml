<Window x:Class="Roomie.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Roomie.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="600" Width="960" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Status}" />
            <Separator />
            <StatusBarItem Content="{Binding NetworkSummary}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="12" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DisplayId}" Foreground="Gray" FontFamily="Consolas" />

                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,2" Content="Rename"
                                    Command="{Binding SaveUsernameCommand}" IsDefault="True" />
                            <TextBox Text="{Binding UsernameDraft, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="32" AutomationProperties.Name="Username" />
                        </DockPanel>
                        <TextBlock Text="{Binding UsernameError}" Foreground="Firebrick" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Expander Margin="0,8,0,0" Header="Security fingerprint" Foreground="Gray">
                            <TextBlock Margin="0,4,0,0" Text="{Binding Fingerprint}" FontFamily="Consolas"
                                       TextWrapping="Wrap" Foreground="Gray" />
                        </Expander>
                    </StackPanel>
                </Border>

                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Nearby devices" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                                   Text="Names are chosen by each device and aren't verified until you pair." />
                        <TextBlock Margin="0,8,0,0" Text="{Binding DiscoveryProblem}" Foreground="Firebrick"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0" Text="{Binding EmptyListHint}" Foreground="Gray"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ListBox Margin="0,8,0,0" ItemsSource="{Binding NearbyDevices}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Nearby devices">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NearbyDevice}">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="Gray" FontFamily="Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DisplayId, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Address, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Details}" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="LightGray" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="Gray">
                    <Run Text="Version" />
                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="Gray"
                           Text="{Binding DataDirectory, StringFormat='Data: {0}'}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
