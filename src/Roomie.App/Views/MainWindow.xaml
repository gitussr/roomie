<Window x:Class="Roomie.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Roomie.App.ViewModels"
        xmlns:views="clr-namespace:Roomie.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="/Assets/roomie.ico"
        Height="680" Width="1040" MinHeight="560" MinWidth="720"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <views:SectionToCheckedConverter x:Key="SectionChecked" />
        <views:SectionToVisibilityConverter x:Key="SectionVisible" />
        <views:CountToVisibilityConverter x:Key="CountVisible" />
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>

    <Grid>
    <!-- The app itself. Hidden and not just covered during the welcome, so a screen reader doesn't read it out behind it. -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Welcome.IsVisible}" Value="True">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Image DockPanel.Dock="Top" Source="/Assets/roomie.png" Width="34" Height="34" Margin="0,14,0,12" AutomationProperties.Name="Roomie" />
                <RadioButton DockPanel.Dock="Bottom" GroupName="Rail" Style="{StaticResource RailButton}" AutomationProperties.Name="Settings"
                             Margin="6,3,6,8"
                             IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=Settings}">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <StackPanel>
                    <RadioButton GroupName="Rail" Style="{StaticResource RailButton}" AutomationProperties.Name="Chats"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=Chats}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="Chats" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-12,0"
                                    Visibility="{Binding TotalUnread, Converter={StaticResource CountVisible}}">
                                <TextBlock Text="{Binding TotalUnread}" Style="{StaticResource BadgeText}" AutomationProperties.Name="{Binding TotalUnread, StringFormat='{}{0} unread'}" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton GroupName="Rail" Style="{StaticResource RailButton}" AutomationProperties.Name="Devices"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=Devices}">
                        <StackPanel>
                            <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Devices" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Rail" Style="{StaticResource RailButton}" AutomationProperties.Name="Transfers"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionChecked}, ConverterParameter=Transfers}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="Transfers" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-12,0"
                                    Visibility="{Binding TransfersNeedingAttention, Converter={StaticResource CountVisible}}">
                                <TextBlock Text="{Binding TransfersNeedingAttention}" Style="{StaticResource BadgeText}" />
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Screens. They stay loaded, so a draft or a scroll position survives moving between them. -->
        <views:ChatsView x:Name="Chats" Grid.Column="1" Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=Chats}" />
        <views:DevicesView Grid.Column="1" Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=Devices}" />
        <views:TransfersView Grid.Column="1" Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=Transfers}" />
        <views:SettingsView Grid.Column="1" Visibility="{Binding Section, Converter={StaticResource SectionVisible}, ConverterParameter=Settings}" />

        <Border Grid.Column="1" Grid.Row="1" Padding="14,5" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OnlineSummary}" Style="{StaticResource MutedText}" Margin="14,0,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>

        <!-- The first-run walkthrough has the whole window until it's finished or skipped. -->
        <views:WelcomeView x:Name="Welcome"
                           Visibility="{Binding Welcome.IsVisible, Converter={StaticResource BoolToVisibility}}" />

        <!-- Pairing covers everything else, the welcome too: it has a time limit and needs an answer. -->
        <Border x:Name="PairingCover" Background="{DynamicResource ScrimBrush}"
                Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle"
                Visibility="{Binding Pairing.IsVisible, Converter={StaticResource BoolToVisibility}}">
            <views:PairingView DataContext="{Binding Pairing}" />
        </Border>

        <!-- Over everything, and only when Roomie opens. -->
        <views:SplashView x:Name="Splash" />
    </Grid>
</Window>
