<UserControl x:Class="Roomie.App.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="480" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />

            <Border Margin="0,20,0,0" Padding="24,12" HorizontalAlignment="Center" CornerRadius="6"
                    Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Visibility="{Binding HasCode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Code}" FontSize="44" FontFamily="Consolas" FontWeight="SemiBold"
                           AutomationProperties.Name="Verification code" />
            </Border>

            <TextBlock Margin="0,16,0,0" Text="{Binding Instruction}" TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ProblemBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                <Button Content="The codes match" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" Margin="4" Padding="14,6"
                        Visibility="{Binding CanApprove, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Margin="4" Padding="14,6"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Block this device" Command="{Binding BlockCommand}" Margin="4" Padding="14,6"
                        Visibility="{Binding CanBlock, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Close" Command="{Binding DismissCommand}" Margin="4" Padding="14,6"
                        Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>

            <Expander Margin="0,20,0,0" Header="Compare full fingerprints"
                      Visibility="{Binding HasCode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="For extra assurance, read these out and check each one against the Security fingerprint in Settings on that computer." />
                    <TextBlock Margin="0,8,0,0" Text="This computer" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LocalFingerprint}" FontFamily="Consolas" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding RemoteLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RemoteFingerprint}" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
